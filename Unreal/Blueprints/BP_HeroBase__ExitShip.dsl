; Jumps off the ship: falls with low gravity and full air control (skydive, then glide near the ground)
(fn ExitShip (DropLocation)
  (Transformation|DetachFromActor :LocationRule "KeepWorld" :RotationRule "KeepWorld" :ScaleRule "KeepWorld")
  (Transformation|SetActorLocation :NewLocation DropLocation :bSweep false :bTeleport true)
  (Rendering|SetActorHiddenInGame :bNewHidden false)
  (Collision|SetActorEnableCollision :bNewActorEnableCollision true)
  (bind cm (Variables|Character|GetCharacterMovement))
  (Pawn|Components|CharacterMovement|SetMovementMode :self cm :NewMovementMode "MOVE_Falling")
  (Class|CharacterMovementComponent|SetGravityScale :self cm :GravityScale 0.6)
  (Class|CharacterMovementComponent|SetAirControl :self cm :AirControl 1.0)
  (Variables|Default|SetOnShip false)
  (Variables|Default|SetSkydiving true)
  (Class|SpringArmComponent|SetTargetArmLength :self (Variables|Camera|GetCameraBoom) :TargetArmLength (Variables|Default|GetDefaultCameraDistance)))
