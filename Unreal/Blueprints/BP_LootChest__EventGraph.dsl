; Abrir sorteia o loot na hora (GDD 8.4) da tabela DT_Itens: 1 item, 1 consumível e GrimoireChance de um grimório
(event EventInteract (Hero)
  (if (not (Variables|Default|GetOpened))
    (Variables|Default|SetOpened true)
    (Components|StaticMesh|SetStaticMesh :self (Variables|Default|GetChestMesh) :NewMesh (Variables|Default|GetOpenMesh))
    (Collision|SetCollisionEnabled :self (Variables|Default|GetInteractSphere) :NewType "NoCollision")
    (Class|BPHeroBase|ClearInteractable :self Hero :Target self)
    (bind dt (Nexus|Itens|TabelaPadrao))
    (bind item (Nexus|Itens|SortearItem :Tabela dt :Tipo "Equipamento"))
    (bind r0 (CallFunction|RollRarity))
    (CallFunction|SpawnItem :ItemId item :Kind 0 :Rarity r0 :Slot 0)
    (bind cons (Nexus|Itens|SortearItem :Tabela dt :Tipo "Consumivel"))
    (CallFunction|SpawnItem :ItemId cons :Kind 2 :Rarity 0 :Slot 1)
    (if (Math|Random|RandomBoolwithWeight :Weight (Variables|Default|GetGrimoireChance))
      (bind grim (Nexus|Itens|SortearItem :Tabela dt :Tipo "Grimorio"))
      (bind r2 (CallFunction|RollRarity))
      (CallFunction|SpawnItem :ItemId grim :Kind 1 :Rarity r2 :Slot 2))))
