; Server: starts the clock and pre-rolls the 7 circle centres (phase 0 = island centre); each new circle fits inside the previous one
(fn StartStorm ()
  (Variables|Default|SetStartTime (CallFunction|ServerTime))
  (bind centers (Variables|Default|GetCenters))
  (Utilities|Array|Clear centers)
  (Utilities|Array|Add centers (Math|Vector|MakeVector :X 0.0 :Y 0.0 :Z 0.0))
  (for i (range 1 7)
    (bind prevR (CallFunction|StormValue :Row "Radius" :Phase (- i 1)))
    (bind newR (CallFunction|StormValue :Row "Radius" :Phase i))
    (bind ang (Math|Random|RandomFloatinRange :Min 0.0 :Max 360.0))
    (bind dist (Math|Random|RandomFloatinRange :Min 0.0 :Max (* (- prevR newR) 90.0)))
    (bind prev (Utilities|Array|Get(acopy) centers (- i 1)))
    (bind offset (Math|Vector|MakeVector :X (* (Math|Trig|Cos(Degrees) ang) dist) :Y (* (Math|Trig|Sin(Degrees) ang) dist) :Z 0.0))
    (Utilities|Array|Add centers (+ prev offset)))
  (Variables|Default|SetLastPhase 0)
  (Variables|Default|SetStarted true))
