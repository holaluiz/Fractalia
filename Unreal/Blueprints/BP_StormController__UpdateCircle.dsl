; Current circle from the clock: waiting = previous circle, closing = lerp to the next one; 7 = fully closed.
; Starts as "closed" and the loop fills in the first phase that has not ended (the DSL drops (return) inside loops).
(fn UpdateCircle ()
  (bind t (- (CallFunction|ServerTime) (Variables|Default|GetStartTime)))
  (bind centers (Variables|Default|GetCenters))
  (Variables|Default|SetCurPhase 7)
  (Variables|Default|SetCurRadius 0.0)
  (Variables|Default|SetCurCenter (Utilities|Array|Get(acopy) centers 6))
  (Variables|Default|SetClosing false)
  (for i (range 1 7)
    (if (== (Variables|Default|GetCurPhase) 7)
      (bind s (CallFunction|StormValue :Row "ShrinkStart" :Phase i))
      (bind e (CallFunction|StormValue :Row "ShrinkEnd" :Phase i))
      (bind r0 (CallFunction|StormValue :Row "Radius" :Phase (- i 1)))
      (bind r1 (CallFunction|StormValue :Row "Radius" :Phase i))
      (bind c0 (Utilities|Array|Get(acopy) centers (- i 1)))
      (bind c1 (Utilities|Array|Get(acopy) centers i))
      (if (< t s)
        (Variables|Default|SetCurCenter c0)
        (Variables|Default|SetCurRadius (* r0 100.0))
        (Variables|Default|SetCurPhase i)
        (elif (< t e)
          (bind a (/ (- t s) (- e s)))
          (Variables|Default|SetCurCenter (Math|Vector|Lerp(Vector) c0 c1 a))
          (Variables|Default|SetCurRadius (* (Math|Float|Lerp r0 r1 a) 100.0))
          (Variables|Default|SetCurPhase i)
          (Variables|Default|SetClosing true))))))
