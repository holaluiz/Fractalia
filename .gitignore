# Nexus Royale: o que NÃO vai para o git.
# Regra geral: só vai o que não dá para gerar de novo nem baixar de novo.

# --- Unreal: gerado pelo editor ou pelo compilador ---
Unreal/NexusRoyale/Binaries/
Unreal/NexusRoyale/Intermediate/
Unreal/NexusRoyale/Saved/
Unreal/NexusRoyale/DerivedDataCache/
Unreal/NexusRoyale/Plugins/*/Binaries/
Unreal/NexusRoyale/Plugins/*/Intermediate/
Unreal/NexusRoyale/.vs/
Unreal/NexusRoyale/*.sln
Unreal/NexusRoyale/*.slnx
*.VC.db
*.VC.opendb
*.suo
*.sdf
.vs/
.idea/
.vscode/

# --- Builds empacotados (ficam fora do repositório, em D:\NexusRoyale_Builds) ---
Builds/
Packaged/

# --- Python ---
__pycache__/
*.pyc

# --- Blender: cópias automáticas ---
*.blend1
*.blend2

# --- Claude Code: estado local de cada sessão ---
.claude/hooks/state/
.claude/settings.local.json

# --- Launcher: o que ele baixa e instala na pasta dele ---
Launcher/game/
Launcher/download/
Launcher/versao.txt
Launcher/token.txt

# --- Packs da Quaternius: dá para baixar de novo (Quaternius/download.ps1) ---
# Os assets já importados estão em Unreal/NexusRoyale/Content/Quaternius e vão para o git.
Quaternius/_zips/
Quaternius/*/
!Quaternius/*.py
!Quaternius/*.ps1
!Quaternius/*.txt

# --- v1 abandonada: FBX gerados pelo Blender e capturas antigas ---
Export/

# --- Sistema ---
Thumbs.db
desktop.ini
.DS_Store
